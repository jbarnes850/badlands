{
  "scenario_id": "mission_desk_enclave",
  "name": "Mission Desk Enclave",
  "description": "Small enterprise mission cell with workstations, identity, mission app, file share, ticket surface, and replayable SIEM/EDR-style telemetry.",
  "auth_affinity_dataset": "badlands/datasets/lanl_auth_affinity_sample.csv",
  "attacker": {
    "initial_host": "ws-alice",
    "initial_credentials": ["alice"],
    "initial_compromised_hosts": ["ws-alice"],
    "credential_target_user": "bob",
    "lateral_target_host": "files-1",
    "collection_target": "mission.txt",
    "protected_assets": [
      {
        "asset_id": "mission-package",
        "file": "mission.txt",
        "host_id": "files-1",
        "service_id": "file_share",
        "sensitivity": 5,
        "mission_dependency": "use_mission_app"
      }
    ],
    "objectives": [
      {
        "objective_id": "collect-mission-package",
        "type": "collection",
        "asset_id": "mission-package",
        "attck": ["TA0009", "T1005"],
        "validation_source": "ATT&CK Collection / Data from Local System plus Mordor/OpTC file-read telemetry shape"
      },
      {
        "objective_id": "exfiltrate-mission-package",
        "type": "exfiltration",
        "asset_id": "mission-package",
        "attck": ["TA0010", "T1041"],
        "egress": "contained-sink.badlands.local",
        "validation_source": "ATT&CK Exfiltration over C2 Channel modelled as contained network telemetry only"
      },
      {
        "objective_id": "disrupt-mission-app",
        "type": "disruption",
        "service_id": "mission_app",
        "attck": ["TA0040", "T1499"],
        "validation_source": "ATT&CK Impact / Endpoint Denial of Service modelled as dependency degradation"
      }
    ]
  },
  "hosts": [
    {"host_id": "ws-alice", "role": "workstation", "owner": "alice", "criticality": 2},
    {"host_id": "ws-bob", "role": "workstation", "owner": "bob", "criticality": 2},
    {"host_id": "ws-carol", "role": "workstation", "owner": "carol", "criticality": 1},
    {"host_id": "ws-dave", "role": "workstation", "owner": "dave", "criticality": 1},
    {"host_id": "ws-erin", "role": "workstation", "owner": "erin", "criticality": 1},
    {"host_id": "ws-frank", "role": "workstation", "owner": "frank", "criticality": 1},
    {"host_id": "ws-grace", "role": "workstation", "owner": "grace", "criticality": 1},
    {"host_id": "ws-heidi", "role": "workstation", "owner": "heidi", "criticality": 1},
    {"host_id": "ws-ivan", "role": "workstation", "owner": "ivan", "criticality": 1},
    {"host_id": "ws-judy", "role": "workstation", "owner": "judy", "criticality": 1},
    {"host_id": "ws-mallory", "role": "workstation", "owner": "mallory", "criticality": 1},
    {"host_id": "ws-oscar", "role": "workstation", "owner": "oscar", "criticality": 1},
    {"host_id": "files-1", "role": "file_share", "owner": "svc-files", "criticality": 5, "files": {"mission.txt": "target package"}},
    {"host_id": "app-1", "role": "mission_app", "owner": "svc-app", "criticality": 5},
    {"host_id": "idp-1", "role": "identity", "owner": "svc-idp", "criticality": 5}
  ],
  "users": [
    {"user_id": "alice", "primary_host": "ws-alice", "credentials_exposed": true},
    {"user_id": "bob", "primary_host": "ws-bob"},
    {"user_id": "carol", "primary_host": "ws-carol"},
    {"user_id": "dave", "primary_host": "ws-dave"},
    {"user_id": "erin", "primary_host": "ws-erin"},
    {"user_id": "frank", "primary_host": "ws-frank"},
    {"user_id": "grace", "primary_host": "ws-grace"},
    {"user_id": "heidi", "primary_host": "ws-heidi"},
    {"user_id": "ivan", "primary_host": "ws-ivan"},
    {"user_id": "judy", "primary_host": "ws-judy"},
    {"user_id": "mallory", "primary_host": "ws-mallory"},
    {"user_id": "oscar", "primary_host": "ws-oscar"}
  ],
  "mission": {
    "task_template": "use_mission_app",
    "green_task_schedule": [2, 8, 14, 20, 26, 32],
    "dependencies": {
      "use_mission_app": ["idp-1", "app-1", "files-1"]
    }
  },
  "benign_noise": {
    "description": "Mission/admin artifacts that can resemble suspicious telemetry without carrying hidden benign/malicious truth to actors.",
    "events": [
      {
        "at": 5,
        "kind": "failed_auth_burst",
        "user": "carol",
        "host": "ws-carol",
        "attempts": 3,
        "source": "LANL auth event shape plus common stale-password user error"
      },
      {
        "at": 11,
        "kind": "noisy_script",
        "user": "dave",
        "host": "ws-dave",
        "process": "mission-cache-refresh",
        "command_line": "mission-cache-refresh --sync --quiet",
        "source": "OpTC endpoint process telemetry shape plus mission admin maintenance"
      },
      {
        "at": 17,
        "kind": "file_access_burst",
        "user": "bob",
        "host": "ws-bob",
        "file": "mission.txt",
        "count": 7,
        "source": "Mission deadline file-read burst shaped like collection telemetry"
      },
      {
        "at": 23,
        "kind": "service_health_blip",
        "service": "mission_app",
        "duration": 2,
        "source": "NCSC automated-response risk and service dependency monitoring"
      },
      {
        "at": 29,
        "kind": "ticket_spike",
        "user": "erin",
        "host": "ws-erin",
        "count": 2,
        "reason": "intermittent_latency",
        "source": "Mission user reports as defender-facing uncertainty"
      }
    ]
  },
  "sensor_model": {
    "description": "Small deterministic-by-seed sensor profile for DS-20 smoke runs. It models coverage, visibility delay, dropped events, and alert delay rather than full statistical reproduction.",
    "default": {"coverage": 1.0, "drop_rate": 0.0, "delay": 1, "alert_delay": 2},
    "categories": {
      "auth": {"sensor_id": "idp-audit-log", "coverage": 1.0, "drop_rate": 0.0, "delay": 1, "alert_delay": 1},
      "auth_anomaly": {"sensor_id": "idp-anomaly-log", "coverage": 0.9, "drop_rate": 0.05, "delay": 3, "alert_delay": 2},
      "credential_access": {"sensor_id": "edr-credential-rule", "coverage": 0.85, "drop_rate": 0.1, "delay": 4, "alert_delay": 2},
      "persistence": {"sensor_id": "edr-startup-monitor", "coverage": 0.8, "drop_rate": 0.1, "delay": 5, "alert_delay": 3},
      "lateral_movement": {"sensor_id": "network-auth-correlation", "coverage": 0.75, "drop_rate": 0.15, "delay": 4, "alert_delay": 2},
      "network": {"sensor_id": "zeek-flow-summary", "coverage": 0.7, "drop_rate": 0.2, "delay": 3, "alert_delay": 2},
      "file": {"sensor_id": "file-share-audit", "coverage": 0.85, "drop_rate": 0.05, "delay": 2, "alert_delay": 2},
      "service": {"sensor_id": "service-log-forwarder", "coverage": 0.9, "drop_rate": 0.05, "delay": 2, "alert_delay": 2},
      "service_health": {"sensor_id": "service-health-monitor", "coverage": 0.85, "drop_rate": 0.05, "delay": 2, "alert_delay": 1}
    }
  },
  "services": [
    {"service_id": "idp", "host_id": "idp-1", "kind": "identity", "criticality": 5},
    {"service_id": "mission_app", "host_id": "app-1", "kind": "web_app", "criticality": 5, "depends_on": ["idp", "file_share"]},
    {"service_id": "file_share", "host_id": "files-1", "kind": "file_share", "criticality": 5},
    {"service_id": "ticket", "host_id": "app-1", "kind": "ticket_surface", "criticality": 3}
  ],
  "provenance": [
    {
      "field": "auth_affinity_dataset",
      "taxonomy": "virtualisation:user-simulation",
      "source": "LANL public cyber datasets user-computer authentication associations",
      "url": "https://csr.lanl.gov/data/",
      "validation_plan": "Replace fixture sample with scripted transform from public LANL auth association release."
    },
    {
      "field": "hosts",
      "taxonomy": "virtualisation:network-host-simulation",
      "source": "Mission Desk minimum environment contract and NCSC baseline-security guidance",
      "url": "https://www.ncsc.gov.uk/blogs/why-cyber-defenders-need-to-be-ready-for-frontier-ai",
      "validation_plan": "Calibrate asset inventory, criticality, and dependencies against mission-owner scenario reviews."
    },
    {
      "field": "mission.green_task_schedule",
      "taxonomy": "modelling:sequence-time",
      "source": "arXiv 2604.08805v1 sequence modelling and Badlands event-driven timing contract",
      "url": "https://arxiv.org/abs/2604.08805",
      "validation_plan": "Expand into scenario-specific work calendars in DS-28 without changing trace semantics."
    },
    {
      "field": "mission.dependencies",
      "taxonomy": "modelling:action-reward",
      "source": "NCSC warning that automated mitigation can disrupt operations more than the attack",
      "url": "https://www.ncsc.gov.uk/blogs/why-cyber-defenders-need-to-be-ready-for-frontier-ai",
      "validation_plan": "Propagate dependency failure through active services in DS-18."
    },
    {
      "field": "attacker",
      "taxonomy": "virtualisation:threat-simulation",
      "source": "Mordor/CALDERA/ATT&CK-style intrusion chain with explicit collection, exfiltration, and impact objectives",
      "url": "https://attack.mitre.org/",
      "validation_plan": "Calibrate collection/exfiltration/disruption prerequisites and artifacts against CALDERA abilities or ATT&CK-mapped Mordor/OpTC replay traces."
    },
    {
      "field": "benign_noise",
      "taxonomy": "virtualisation:user-simulation",
      "source": "LANL auth/process/service event shapes, OpTC endpoint telemetry shape, and NCSC warning about benign operational activity plus harmful automated response",
      "url": "https://csr.lanl.gov/data/cyber1/",
      "validation_plan": "Replace heuristic rates with explicit LANL/OpTC/Mordor-derived calibration tables in DS-25/DS-26."
    },
    {
      "field": "sensor_model",
      "taxonomy": "modelling:observation",
      "source": "arXiv 2604.08805v1 observation modelling guidance plus ECS/Sigma/Elastic-style alert-source provenance",
      "url": "https://arxiv.org/abs/2604.08805",
      "validation_plan": "Calibrate coverage, drop, and delay profiles against real log pipelines or emulated telemetry during calibration work."
    }
  ]
}
