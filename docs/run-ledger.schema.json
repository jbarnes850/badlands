{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BadlandsRunLedgerEntry",
  "type": "object",
  "required": [
    "timestamp_utc",
    "issue_id",
    "commit",
    "command",
    "seed",
    "trace_path",
    "report_path",
    "score_summary",
    "endpoint_topology",
    "model_id_by_role",
    "endpoint_by_role",
    "harness_version",
    "scenario_id",
    "scenario_version",
    "fixture_hash",
    "agent_scaffold_id",
    "memory_mode",
    "tool_surface_id",
    "token_budget",
    "wall_clock_budget_minutes",
    "cost_estimate_usd",
    "power_or_device_class",
    "run_tier",
    "baseline_run_id",
    "comparison_axis",
    "capability_curve_group_id",
    "advertised_context_tokens_by_role",
    "served_context_tokens_by_role",
    "served_context_evidence_by_role",
    "qualitative_findings",
    "blocker",
    "failure_classification",
    "review_status"
  ],
  "properties": {
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "issue_id": { "type": "string" },
    "commit": { "type": "string" },
    "command": { "type": "string" },
    "seed": { "type": ["integer", "null"] },
    "trace_path": { "type": ["string", "null"] },
    "report_path": { "type": ["string", "null"] },
    "score_summary": { "type": "object", "additionalProperties": true },
    "endpoint_topology": { "type": "object", "additionalProperties": true },
    "model_id_by_role": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
    "endpoint_by_role": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
    "harness_version": { "type": ["string", "null"] },
    "scenario_id": { "type": ["string", "null"] },
    "scenario_version": { "type": ["string", "null"] },
    "fixture_hash": { "type": ["string", "null"] },
    "agent_scaffold_id": { "type": ["string", "null"] },
    "memory_mode": {
      "enum": ["none", "trace-only", "SDK-session", "campaign", null]
    },
    "tool_surface_id": { "type": ["string", "null"] },
    "retrieval_mode": {
      "enum": ["none", "fixed-window", "event-id", "case", "hybrid", null]
    },
    "compaction_mode": {
      "enum": ["none", "fixed-summary", "evidence-preserving-summary", "SDK-managed", null]
    },
    "search_policy": {
      "enum": ["single-sample", "repair-only", "parallel-samples", "verifier-pass", "rollout-search", "other", null]
    },
    "self_improvement_mode": {
      "enum": ["none", "offline-human-update", "scaffold-update", "prompt-update", "tool-update", "model-update", null]
    },
    "token_budget": { "type": ["object", "null"], "additionalProperties": true },
    "wall_clock_budget_minutes": { "type": ["number", "null"] },
    "cost_estimate_usd": { "type": ["number", "null"] },
    "power_or_device_class": { "type": ["string", "null"] },
    "run_tier": {
      "enum": ["smoke", "1h", "3h", "6h", "overnight", null]
    },
    "baseline_run_id": { "type": ["string", "null"] },
    "comparison_axis": {
      "enum": [
        "none",
        "model",
        "tokens",
        "memory",
        "harness",
        "scenario",
        "tool_surface",
        "served_context",
        "wall_clock",
        "cost_power",
        null
      ]
    },
    "capability_curve_group_id": { "type": ["string", "null"] },
    "advertised_context_tokens_by_role": {
      "type": ["object", "null"],
      "additionalProperties": { "type": ["integer", "null"] }
    },
    "served_context_tokens_by_role": {
      "type": ["object", "null"],
      "additionalProperties": { "type": ["integer", "null"] }
    },
    "served_context_evidence_by_role": {
      "type": ["object", "null"],
      "additionalProperties": { "type": ["string", "null"] }
    },
    "qualitative_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocker": { "type": ["string", "null"] },
    "failure_classification": {
      "enum": [
        "none",
        "endpoint_unreachable",
        "endpoint_saturated",
        "serving_bottleneck",
        "agent_loop_bottleneck",
        "model_schema_brittleness",
        "environment_failure",
        "replay_failure",
        "trace_evidence_gap",
        "observation_leak",
        "scope_blocker",
        "unknown"
      ]
    },
    "review_status": {
      "enum": ["not_reviewed", "approved", "not_approved", "blocked"]
    },
    "duration_minutes": { "type": ["number", "null"] },
    "attacker_tokens": { "type": ["integer", "null"] },
    "defender_tokens": { "type": ["integer", "null"] },
    "green_tokens": { "type": ["integer", "null"] },
    "total_completion_tokens": { "type": ["integer", "null"] },
    "invalid_decision_rate": { "type": ["number", "null"] },
    "strategy_change_summary": { "type": ["string", "null"] },
    "co_evolution_mode": {
      "enum": [
        "none",
        "within_run_adaptation",
        "cross_episode_memory",
        "scaffold_evolution",
        "tool_surface_evolution",
        "scenario_evolution",
        "model_evolution",
        null
      ]
    },
    "campaign_id": { "type": ["string", "null"] },
    "sdk_session_ids": { "type": ["object", "null"], "additionalProperties": true }
  },
  "additionalProperties": false
}
